# Copy to Railway / Render → Environment variables (do not commit real values)

# Railway: use Java 17 (pom.xml target). Java 21 can cause Atlas SSL "internal_error".
NIXPACKS_JDK_VERSION=17

# Tránh "Service ran out of memory" trên free tier (tuỳ chọn nếu vẫn OOM: -Xmx384m)
JAVA_TOOL_OPTIONS=-XX:+UseContainerSupport -XX:MaxRAMPercentage=70.0

# Profile
SPRING_PROFILES_ACTIVE=staging

# MongoDB Atlas — project "salesdb-test" (M0, Singapore), không dùng salesdb / salesdb-dev
# Atlas → Connect → Drivers → Java — copy full SRV string (password URL-encoded if special chars)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster.vr10ibi.mongodb.net/?retryWrites=true&w=majority&appName=salsales-staging
MONGODB_DATABASE=salesdb-test

# JWT — generate a random string >= 32 characters (unique per environment)
APP_JWT_SECRET=change-me-staging-only-32chars-minimum

# Frontend (Vercel production URL for this project)
FRONTEND_URL=https://your-app.vercel.app
# CORS + WebSocket: main URL + Vercel preview branches (comma-separated, no spaces)
FRONTEND_CORS_ORIGINS=https://your-app.vercel.app,https://*.vercel.app
FRONTEND_VERIFY_URL=https://your-app.vercel.app/verify

# Google Sign-In (same OAuth client as dev; add authorized origins in Google Cloud Console)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

WEBHOOK_SECRET=staging-webhook-secret-change-me

# Optional — email verification / reset password / thông báo admin
# MAIL_USERNAME=
# MAIL_PASSWORD=
# ADMIN_USER_REGISTRATION_NOTIFY_ENABLED=true
# ADMIN_REGISTRATION_NOTIFY_EMAILS=ops@example.com

# Optional — product image upload (staging bucket or leave empty)
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# AWS_S3_BUCKET=
# AWS_REGION=ap-southeast-1

# Billing redirect after payment (defaults to FRONTEND_URL/billing if unset)
# VNPAY_RETURN_URL=https://your-app.vercel.app/billing
# MOMO_REDIRECT_URL=https://your-app.vercel.app/billing
# MOMO_IPN_URL=https://your-api.up.railway.app/api/webhook/momo
